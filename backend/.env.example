PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=https://your-backend.vercel.app

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+61400000000

# OpenAI
OPENAI_API_KEY=sk-...

# Firebase Admin
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# OR use a single JSON string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google OAuth (for Gmail)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/email/callback

# Stripe (test mode — keys starting with sk_test_ / whsec_ from a test webhook endpoint)
# 1. Create a $199/month AUD recurring Price in the Stripe test dashboard and paste its id below.
# 2. Add a webhook endpoint pointing at {BACKEND_URL}/api/billing/webhook listening for:
#    checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
