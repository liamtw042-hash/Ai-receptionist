PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=https://your-backend.vercel.app

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+61400000000

# OpenAI
OPENAI_API_KEY=sk-...

# Firebase Admin
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# OR use a single JSON string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google OAuth — one connection covers Sheets, Calendar, and Gmail auto-reply.
# Add http(s)://<host>/api/google/callback as an Authorized redirect URI in
# the Google Cloud Console for this OAuth client.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback

# Stripe (test mode — keys starting with sk_test_ / whsec_ from a test webhook endpoint)
# 1. Create a $199/month AUD recurring Price in the Stripe test dashboard and paste its id below.
# 2. Add a webhook endpoint pointing at {BACKEND_URL}/api/billing/webhook listening for:
#    checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Secures GET /api/email/poll, which the Vercel Cron job (see vercel.json)
# hits every few minutes to auto-reply to new enquiry emails for every
# connected user. Vercel automatically sends this value as a Bearer token on
# cron-triggered requests once it's set as an env var — generate any random
# string for it (e.g. `openssl rand -hex 32`).
CRON_SECRET=

# Public marketing-page chat widget (POST /api/chat/widget). This endpoint is
# unauthenticated and costs OpenAI money per call, so it's rate-limited per IP
# per day (Firestore-backed, collection `chat_widget_usage`). Optional — leave
# unset to use the default of 30 messages/IP/day.
CHAT_WIDGET_DAILY_LIMIT=30

# New public marketing collections created by these routes (no extra config
# needed — listed here for reference):
#   - newsletter_signups   (POST /api/newsletter/subscribe)
#   - chat_widget_usage    (per-IP-per-day chat rate-limit counters)
