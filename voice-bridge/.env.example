# ── Required ──────────────────────────────────────────────────────────────────

# OpenAI key with Realtime API access.
OPENAI_API_KEY=sk-...

# The existing TradeDesk backend, INCLUDING the /api suffix.
# e.g. https://tradedesk-backend-delta.vercel.app/api
BACKEND_API_URL=https://your-backend.vercel.app/api

# Shared secret. Must be IDENTICAL to VOICE_BRIDGE_SECRET in the Vercel backend
# env. Generate with: openssl rand -hex 32
VOICE_BRIDGE_SECRET=

# The public https origin of THIS service, no trailing slash.
# e.g. https://tradedesk-voice-bridge.up.railway.app
PUBLIC_URL=https://your-bridge-host.example.com

# ── Twilio (needed for mid-call failure recovery + webhook verification) ──────
# Without these the bridge still runs, but a dropped realtime session cannot be
# rescued into voicemail, and inbound webhooks are not signature-checked.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
VALIDATE_TWILIO_SIGNATURE=true

# ── Model & voice ─────────────────────────────────────────────────────────────
# gpt-realtime-2.1        — best quality (default)
# gpt-realtime-2.1-mini   — ~3x cheaper, faster, less reliable at detail capture
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# marin (default) | cedar | alloy | ash | ballad | coral | echo | sage | shimmer | verse
# marin and cedar are OpenAI's recommended, most natural voices.
OPENAI_REALTIME_VOICE=marin

# 1.0 = natural. <0.9 sounds sedated, >1.15 sounds rushed.
OPENAI_VOICE_SPEED=1.0

# ── Turn detection (how it decides you've stopped talking) ────────────────────
# semantic_vad — a model judges whether the thought is finished. Best at not
#                cutting people off when they pause. DEFAULT.
# server_vad   — raw silence timing. More predictable, more tunable in noise.
TURN_DETECTION=semantic_vad

# semantic_vad only. Max wait: low 8s, medium 4s, high 2s.
VAD_EAGERNESS=medium

# server_vad only — ignored under semantic_vad.
VAD_THRESHOLD=0.6
VAD_PREFIX_PADDING_MS=300
VAD_SILENCE_DURATION_MS=700
VAD_IDLE_TIMEOUT_MS=8000

# near_field (handset to the face — default) | far_field (speakerphone/car) | none
NOISE_REDUCTION=near_field

# ── Cost controls ─────────────────────────────────────────────────────────────
# Hard ceiling per call. OpenAI has NO server-side session limit, so this is the
# only thing standing between you and an abandoned open line billing all day.
MAX_CALL_SECONDS=600
MAX_CALL_WARNING_SECONDS=60
MAX_RESPONSE_OUTPUT_TOKENS=1200

# ── Misc ──────────────────────────────────────────────────────────────────────
PORT=8080
OPENAI_CONNECT_TIMEOUT_MS=5000
# Verbose per-call audio counters. Useful when tuning; noisy in production.
DEBUG_AUDIO=false
