{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "tradedesk-frontend-one.vercel.app" }],
      "destination": "https://tradedesk-au.vercel.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
